# Подключение к той же PostgreSQL, что и s_media_service, под ролью analyzer.
DATABASE_URL=postgresql://analyzer:analyzer_password@localhost:5432/s_media_service
# Схема таблиц анализатора (создаётся миграциями).
ANALYSIS_SCHEMA=analysis
# Схема каталога s_media_service (таблицы files, storages) — только чтение.
# В s_media_service фактически задаётся DATABASE_SCHEMA (обычно main).
CATALOG_SCHEMA=main
# JSON: storage_id (uuid) -> путь каталога в контейнере (read-only).
SCAN_ROOTS={"00000000-0000-0000-0000-000000000001": "/storages/photos"}
# Каталог для вырезок лиц (вне SCAN_ROOTS, на запись).
FACES_DIR=/tmp/s_media_faces
# Ключ для заголовка X-API-Key.
API_KEY=secret_key
APP_VERSION=dev
SWAGGER_URL=/docs
REDOC_URL=
# Версия логики/модели анализа: растёт при смене модели или алгоритмов.
ANALYZER_VERSION=1
MODEL_NAME=buffalo_l
# Каталог моделей InsightFace (пусто = ~/.insightface/models). В Docker — предзагружена.
MODEL_ROOT=
DET_SCORE_MIN=0.6
MIN_FACE_PX=40
MAX_IMAGE_SIDE=1600
T_PERSON=0.45
T_CLUSTER=0.5
# Вырезки лиц
CROP_MARGIN=0.3
# Дополнительный отступ сверху (доля высоты bbox) — чтобы не обрезать волосы.
CROP_TOP_MARGIN=0.6
CROP_MAX_SIDE=256
CROP_JPEG_QUALITY=90
WORKER_CONCURRENCY=1
WORKER_NICE=10
WORKER_ACTIVE_HOURS=
LOCK_TIMEOUT_SEC=900
